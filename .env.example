# Copy to .env.local to override the defaults (the defaults already match the mock AEM).
# The same variable names work against a real AEM as a Cloud Service environment, e.g.
#   AEM_PUBLISH_HOST=https://publish-p12345-e67890.adobeaemcloud.com

# --- Server-side only (Server Components, Route Handlers, scripts) -------------------------
AEM_PUBLISH_HOST=http://localhost:4503
AEM_AUTHOR_HOST=http://localhost:4502
AEM_CONFIGURATION_NAME=wknd-shared
AEM_GRAPHQL_ENDPOINT=/content/cq:graphql/wknd-shared/endpoint.json

# Author credentials. NEVER prefix these with NEXT_PUBLIC_ — they must not reach the browser.
# Local AEM SDK: admin/admin. AEM as a Cloud Service: a developer token or service credentials.
AEM_AUTHOR_USER=admin
AEM_AUTHOR_PASSWORD=admin
AEM_AUTHOR_TOKEN=mock-local-dev-token

# --- Exposed to the browser (Client Components) --------------------------------------------
NEXT_PUBLIC_AEM_PUBLISH_HOST=http://localhost:4503
NEXT_PUBLIC_AEM_GRAPHQL_ENDPOINT=/content/cq:graphql/wknd-shared/endpoint.json

# --- Lab 14 (Draft Mode) and Lab 15 (webhooks) ---------------------------------------------
PREVIEW_SECRET=lab-preview-secret
AEM_WEBHOOK_SECRET=mock-webhook-secret

# --- Mock AEM tuning (mock-aem/src/config.ts) ------------------------------------------------
# MOCK_AEM_LATENCY_MS=150
# MOCK_AEM_BLOCK_ADHOC_ON_PUBLISH=false
# MOCK_AEM_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# MOCK_AEM_PERSIST_STATE=true
