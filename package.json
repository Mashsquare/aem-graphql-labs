{
  "name": "aem-graphql-labs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n aem,next -c magenta,cyan \"npm:mock\" \"npm:dev:next\"",
    "dev:next": "next dev",
    "mock": "tsx watch --clear-screen=false mock-aem/server.ts",
    "mock:reset": "tsx mock-aem/scripts/reset.ts",
    "mock:schema": "tsx mock-aem/scripts/print-schema.ts",
    "build": "tsx scripts/build-with-mock.ts",
    "start": "concurrently -k -n aem,next -c magenta,cyan \"tsx mock-aem/server.ts\" \"next start\"",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project labs",
    "test:watch": "vitest --project labs",
    "test:solutions": "vitest run --project solutions",
    "test:mock": "vitest run --project mock",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "lab11:persist": "tsx src/labs/11-aem-persisted-queries/persist-queries.ts",
    "solution11:persist": "tsx src/solutions/11-aem-persisted-queries/persist-queries.ts"
  },
  "dependencies": {
    "@adobe/aem-headless-client-js": "^4.0.0",
    "@apollo/client": "^4.3.5",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@tanstack/react-query": "^5.104.5",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "urql": "^5.0.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
